{
  "name": "@vibcodrx/cli",
  "version": "0.2.8",
  "description": "Conecta o Codex em hosts remotos ao ecossistema Vibcodrx.",
  "type": "module",
  "bin": {
    "vibcodrx": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibcodr/vibcodrx-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vibcodr/vibcodrx-cli/issues"
  },
  "homepage": "https://vibcodrx.app",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
